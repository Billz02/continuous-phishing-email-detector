# IMAP Server Settings (e.g., imap.gmail.com, outlook.office365.com)
IMAP_SERVER=imap.gmail.com

# Email Credentials
# If using Gmail or Outlook, use an App Password, NOT your main password.
EMAIL_ACCOUNT=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Configuration
# How often to check for new emails in seconds (default: 300 = 5 minutes)
CHECK_INTERVAL_SECONDS=300

# The folder to move phishing emails into
QUARANTINE_FOLDER=Quarantine

# [OPTIONAL BUT RECOMMENDED] Gemini API Key for Advanced AI Detection
# Get one at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

